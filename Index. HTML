<style>
  :root{
    --bg:#0B0B0E;
    --bg-alt:#111014;
    --glass:rgba(255,255,255,.07);
    --glass-strong:rgba(255,255,255,.12);
    --glass-border:rgba(255,255,255,.16);
    --rose:#F0A8C0;
    --rose-deep:#D97B9C;
    --gold:#D8B47E;
    --gold-soft:#EAD2A3;
    --text:#F6F1EC;
    --text-soft:#B7B0A8;
    --serif:'Playfair Display', serif;
    --serif-i:'Cormorant Garamond', serif;
    --sans:'Jost', sans-serif;
    --arfont:'Tajawal','Jost', sans-serif;
    --maxw:1280px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;background:var(--bg);color:var(--text);font-family:var(--sans);
    -webkit-font-smoothing:antialiased;overflow-x:hidden;
  }
  html[dir="rtl"] body{font-family:var(--arfont);}
  img{max-width:100%;display:block;}
  a{color:inherit;text-decoration:none;}
  button{font-family:inherit;cursor:pointer;}
  input,select,textarea{font-family:inherit;}
  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 32px;}

  /* ===== Ambient glow blobs (fixed, behind everything) ===== */
  .ambient{position:fixed;inset:0;z-index:0;overflow:hidden;pointer-events:none;}
  .blob{position:absolute;border-radius:50%;filter:blur(90px);opacity:.55;}
  .blob.b1{width:520px;height:520px;background:radial-gradient(circle,var(--rose-deep),transparent 70%);top:-140px;left:-120px;animation:drift1 22s ease-in-out infinite;}
  .blob.b2{width:600px;height:600px;background:radial-gradient(circle,var(--gold),transparent 70%);bottom:-200px;right:-160px;animation:drift2 26s ease-in-out infinite;}
  .blob.b3{width:420px;height:420px;background:radial-gradient(circle,var(--rose),transparent 70%);top:40%;left:50%;opacity:.28;animation:drift3 30s ease-in-out infinite;}
  @keyframes drift1{0%,100%{transform:translate(0,0);}50%{transform:translate(60px,50px);}}
  @keyframes drift2{0%,100%{transform:translate(0,0);}50%{transform:translate(-50px,-40px);}}
  @keyframes drift3{0%,100%{transform:translate(-50%,-50%) scale(1);}50%{transform:translate(-45%,-55%) scale(1.15);}}

  main, header, section, footer{position:relative;z-index:1;}

  .eyebrow{font-size:11px;letter-spacing:.24em;text-transform:uppercase;color:var(--gold-soft);font-weight:500;}
  .thread{display:flex;align-items:center;gap:10px;margin:14px 0 22px;}
  .thread::before,.thread::after{content:"";height:1px;flex:1;background:var(--glass-border);}
  .thread span{width:5px;height:5px;border-radius:50%;background:var(--gold);}

  /* ===== Glass base ===== */
  .glass{
    background:var(--glass);
    backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);
    border:1px solid var(--glass-border);
    box-shadow:0 8px 32px rgba(0,0,0,.35), inset 0 1px 0 rgba(255,255,255,.08);
    border-radius:18px;
  }

  /* ===== Header ===== */
  header.site-header{
    position:fixed;top:0;left:0;right:0;z-index:70;
    background:rgba(11,11,14,0);border-bottom:1px solid transparent;
    transition:background .4s ease, border-color .4s ease, backdrop-filter .4s ease;
  }
  header.site-header.scrolled{
    background:rgba(11,11,14,.55);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
    border-bottom:1px solid var(--glass-border);
  }
  .header-inner{display:flex;align-items:center;justify-content:space-between;padding:20px 32px;max-width:var(--maxw);margin:0 auto;}
  .logo{font-family:var(--serif);font-size:21px;letter-spacing:.06em;font-weight:600;color:var(--text);}
  .logo span{color:var(--rose);}
  nav.main-nav{display:flex;gap:36px;}
  nav.main-nav a{font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--text-soft);position:relative;padding-bottom:4px;transition:color .25s ease;}
  nav.main-nav a::after{content:"";position:absolute;left:0;bottom:0;width:0;height:1px;background:var(--gold);transition:width .35s ease;}
  nav.main-nav a:hover{color:var(--text);}
  nav.main-nav a:hover::after{width:100%;}
  .nav-dropdown{position:relative;display:flex;align-items:center;}
  .nav-dropdown-menu{
    position:absolute;top:100%;left:50%;transform:translateX(-50%) translateY(8px);min-width:170px;
    padding:10px;display:flex;flex-direction:column;gap:2px;opacity:0;pointer-events:none;
    transition:opacity .25s ease, transform .25s ease;z-index:71;
    background:rgba(17,16,20,.92);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);
    border:1px solid var(--glass-border);border-radius:14px;box-shadow:0 20px 50px rgba(0,0,0,.5);
  }
  .nav-dropdown:hover .nav-dropdown-menu{opacity:1;pointer-events:auto;transform:translateX(-50%) translateY(0);}
  .nav-dropdown-menu a{padding:8px 10px;border-radius:8px;font-size:11px;}
  .nav-dropdown-menu a::after{display:none;}
  .nav-dropdown-menu a:hover{background:var(--glass);color:var(--text);}
  .header-icons{display:flex;align-items:center;gap:12px;}
  .icon-btn{background:var(--glass);border:1px solid var(--glass-border);border-radius:50%;width:40px;height:40px;
    display:flex;align-items:center;justify-content:center;position:relative;transition:background .25s ease, transform .25s ease;}
  .icon-btn:hover{background:var(--glass-strong);transform:translateY(-2px);}
  .icon-btn svg{width:17px;height:17px;stroke:var(--text);fill:none;stroke-width:1.4;}
  .cart-badge{
    position:absolute;top:-5px;right:-5px;background:var(--rose-deep);color:#fff;font-size:10px;
    width:17px;height:17px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:var(--sans);
  }
  .lang-select{
    background:var(--glass);border:1px solid var(--glass-border);border-radius:20px;height:40px;padding:0 30px 0 16px;
    font-size:11px;letter-spacing:.1em;font-weight:600;appearance:none;-webkit-appearance:none;
    color:var(--text);transition:background .25s ease, transform .25s ease;cursor:pointer;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23ffffff' stroke-width='2'><polyline points='6 9 12 15 18 9'/></svg>");
    background-repeat:no-repeat;background-position:right 10px center;background-size:12px;
  }
  html[dir="rtl"] .lang-select{padding:0 16px 0 30px;background-position:left 10px center;}
  .lang-select:hover{background-color:var(--glass-strong);transform:translateY(-2px);}
  .lang-select option{color:#111;background:#fff;}
  .burger{display:none;background:var(--glass);border:1px solid var(--glass-border);border-radius:50%;width:40px;height:40px;align-items:center;justify-content:center;}
  .burger svg{width:18px;height:18px;stroke:var(--text);fill:none;stroke-width:1.4;}

  .mobile-nav{
    position:fixed;inset:0;background:rgba(11,11,14,.97);z-index:90;transform:translateY(-100%);
    transition:transform .4s ease;padding:100px 36px 32px;display:flex;flex-direction:column;gap:28px;
    backdrop-filter:blur(20px);
  }
  .mobile-nav.open{transform:translateY(0);}
  .mobile-nav a{font-family:var(--serif);font-size:26px;color:var(--text);}
  .mobile-close{position:absolute;top:24px;right:28px;background:var(--glass);border:1px solid var(--glass-border);border-radius:50%;width:40px;height:40px;font-size:20px;color:var(--text);}

  /* ===== Hero ===== */
  .hero{position:relative;height:100vh;min-height:640px;display:flex;align-items:center;justify-content:center;overflow:hidden;}
  .hero video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0;filter:brightness(.55) saturate(1.05);}
  .hero-scrim{position:absolute;inset:0;z-index:1;
    background:linear-gradient(180deg,rgba(11,11,14,.55) 0%, rgba(11,11,14,.35) 45%, rgba(11,11,14,.9) 100%);}
  .hero-content{position:relative;z-index:2;text-align:center;padding:0 24px;max-width:800px;}
  .hero-content .eyebrow{justify-content:center;display:flex;margin-bottom:20px;}
  .hero-content h1{
    font-family:var(--serif);font-size:clamp(48px,9vw,104px);line-height:.98;margin:0 0 22px;font-weight:600;
    letter-spacing:.01em;color:var(--text);text-shadow:0 4px 40px rgba(0,0,0,.4);
  }
  .hero-content .tagline{
    font-family:var(--serif-i);font-style:italic;font-size:clamp(18px,2.4vw,26px);color:var(--gold-soft);
    margin:0 0 44px;font-weight:400;
  }
  html[dir="rtl"] .hero-content .tagline{font-family:var(--arfont);font-style:normal;}
  .scroll-cta{
    display:inline-flex;align-items:center;gap:10px;padding:15px 30px;border-radius:40px;
    font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--text);
  }
  .scroll-cta svg{width:14px;height:14px;stroke:var(--text);fill:none;stroke-width:1.6;animation:bob 1.8s ease-in-out infinite;}
  @keyframes bob{0%,100%{transform:translateY(0);}50%{transform:translateY(5px);}}
  .scroll-cta:hover{background:var(--glass-strong);}

  /* ===== Sections ===== */
  main{background:transparent;}
  .section{padding:120px 0;}
  .section-head{text-align:center;max-width:620px;margin:0 auto 60px;}
  .section-head h2{font-family:var(--serif);font-size:clamp(32px,4.4vw,50px);font-weight:600;margin:0 0 14px;}
  html[dir="rtl"] .section-head h2{font-family:var(--arfont);}
  .section-head p{color:var(--text-soft);font-size:15px;line-height:1.7;margin:0;}
  .section-head .thread{justify-content:center;max-width:120px;margin-inline:auto;}
  .section-head .thread::before,.section-head .thread::after{flex:0 0 40px;}

  /* ===== Product Grid ===== */
  .product-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:26px;}
  .card{
    position:relative;overflow:hidden;display:flex;flex-direction:column;
    transition:transform .45s cubic-bezier(.2,.8,.2,1), box-shadow .45s ease, border-color .45s ease;
  }
  .card:hover{transform:translateY(-10px);border-color:rgba(216,180,126,.4);
    box-shadow:0 24px 48px rgba(0,0,0,.5), 0 0 40px rgba(240,168,192,.12), inset 0 1px 0 rgba(255,255,255,.1);}
  .card::before{
    content:"";position:absolute;top:0;left:-60%;width:40%;height:100%;
    background:linear-gradient(115deg, transparent, rgba(255,255,255,.16), transparent);
    transform:skewX(-18deg);transition:left .9s ease;pointer-events:none;z-index:3;
  }
  .card:hover::before{left:130%;}
  .card-media{position:relative;aspect-ratio:1/1;overflow:hidden;background:linear-gradient(135deg,rgba(240,168,192,.12),rgba(216,180,126,.1));
    border-radius:18px 18px 0 0;cursor:zoom-in;}
  .card-media img{width:100%;height:100%;object-fit:cover;transition:transform .35s ease, opacity .25s ease;transform-origin:var(--zx,50%) var(--zy,50%);}
  .card:hover .card-media img{transform:scale(1.5);}
  .img-nav{
    position:absolute;top:50%;transform:translateY(-50%);width:30px;height:30px;border-radius:50%;
    background:rgba(11,11,14,.55);backdrop-filter:blur(6px);border:1px solid var(--glass-border);
    display:flex;align-items:center;justify-content:center;z-index:4;opacity:0;transition:opacity .25s ease, background .25s ease;
  }
  .card-media:hover .img-nav{opacity:1;}
  .img-nav:hover{background:rgba(11,11,14,.8);}
  .img-nav svg{width:14px;height:14px;stroke:var(--text);fill:none;stroke-width:2;}
  .img-nav.prev{left:10px;}
  .img-nav.next{right:10px;}
  .img-dots{position:absolute;bottom:10px;left:50%;transform:translateX(-50%);display:flex;gap:5px;z-index:4;}
  .img-dots i{width:5px;height:5px;border-radius:50%;background:rgba(255,255,255,.35);display:block;}
  .img-dots i.active{background:var(--gold-soft);}
  .card-body{padding:20px 20px 22px;display:flex;flex-direction:column;gap:9px;flex:1;}
  .card-body h3{font-family:var(--serif);font-size:17px;font-weight:600;margin:0;color:var(--text);line-height:1.35;min-height:44px;}
  html[dir="rtl"] .card-body h3{font-family:var(--arfont);font-size:16px;}
  .card-price{font-family:var(--serif);font-size:20px;margin-top:2px;color:var(--text);}
  html[dir="rtl"] .card-price{font-family:var(--arfont);}
  .card-footer{display:flex;align-items:stretch;justify-content:space-between;gap:6px;margin-top:auto;padding-top:14px;}
  .qty-select{display:flex;align-items:center;justify-content:center;border:1px solid var(--glass-border);border-radius:8px;background:rgba(255,255,255,.04);flex:0 0 auto;}
  .qty-select button{background:none;border:none;width:24px;height:38px;font-size:14px;color:var(--text);}
  .qty-select button:hover{color:var(--gold);}
  .qty-select .qv{width:16px;text-align:center;font-size:11px;color:var(--text);}
  .add-cart-btn{
    flex:1;min-width:0;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:2px 5px;
    background:linear-gradient(120deg,var(--gold-soft),var(--gold) 60%,#b8934a);color:#1a1408;border:none;padding:4px 6px;min-height:38px;
    font-size:9.5px;font-weight:700;letter-spacing:.03em;text-transform:uppercase;border-radius:19px;line-height:1.15;
    text-align:center;overflow:hidden;
    transition:filter .25s ease, transform .25s ease, background .25s ease, box-shadow .25s ease;
    box-shadow:0 4px 14px rgba(197,160,89,.3);
  }
  .add-cart-btn span{white-space:normal;}
  .add-cart-btn svg{width:13px;height:13px;stroke:currentColor;fill:none;stroke-width:1.8;flex-shrink:0;}
  .add-cart-btn:hover{filter:brightness(1.08);transform:translateY(-2px);box-shadow:0 8px 20px rgba(197,160,89,.4);}
  .add-cart-btn:active{transform:translateY(0);}
  .add-cart-btn:disabled{background:rgba(255,255,255,.08);color:var(--text-soft);cursor:not-allowed;box-shadow:none;}
  .add-cart-btn.notify-btn{background:linear-gradient(120deg,#2fdc76,#1ea952);color:#fff;box-shadow:0 4px 14px rgba(37,211,102,.3);}
  .add-cart-btn.notify-btn svg{fill:currentColor;stroke:none;}
  @media (min-width:480px){
    .add-cart-btn{font-size:10.5px;letter-spacing:.08em;padding:0 12px;height:38px;min-height:38px;flex-wrap:nowrap;gap:6px;}
    .add-cart-btn svg{width:14px;height:14px;}
    .qty-select button{width:28px;}
    .qty-select .qv{width:22px;font-size:12px;}
    .card-footer{gap:10px;}
  }

  /* ===== Skeleton Loader (shown while Firebase fetches, no cache yet) ===== */
  .product-grid.is-loading{pointer-events:none;}
  .skeleton-block{
    background:linear-gradient(100deg, rgba(255,255,255,.06) 20%, rgba(255,255,255,.15) 40%, rgba(255,255,255,.06) 60%);
    background-size:200% 100%;animation:skeletonShimmer 1.5s ease-in-out infinite;border-radius:8px;
  }
  @keyframes skeletonShimmer{0%{background-position:200% 0;}100%{background-position:-200% 0;}}
  .skeleton-card{pointer-events:none;}
  .skeleton-card::before{display:none;}
  .skeleton-card .card-media{border-radius:18px 18px 0 0;}
  .skeleton-card .card-body{gap:12px;}
  .skeleton-card .skeleton-title{width:78%;height:17px;}
  .skeleton-card .skeleton-price{width:38%;height:20px;}
  .skeleton-card .card-footer{margin-top:4px;}
  .skeleton-card .skeleton-pill{height:30px;border-radius:24px;flex:0 0 68px;}
  .skeleton-card .skeleton-pill-wide{flex:1;}

  /* ===== Product card entrance (smooths cache -> live-data re-renders) ===== */
  .card{animation:cardFadeIn .4s ease both;}
  @keyframes cardFadeIn{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:translateY(0);}}

  .show-more-wrap{text-align:center;margin-top:52px;}
  .show-more-btn{
    display:inline-flex;align-items:center;gap:10px;padding:15px 40px;border-radius:40px;
    font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--text);background:var(--glass);
    border:1px solid var(--glass-border);transition:background .25s ease, transform .25s ease;
  }
  .show-more-btn:hover{background:var(--glass-strong);transform:translateY(-2px);}

  /* ===== Lightbox ===== */
  .lightbox{
    position:fixed;inset:0;z-index:150;background:rgba(5,5,7,.92);backdrop-filter:blur(6px);
    display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .3s ease;
  }
  .lightbox.show{opacity:1;pointer-events:auto;}
  .lightbox-panel{display:flex;flex-direction:column;align-items:stretch;width:min(720px,92vw);max-height:92vh;overflow-y:auto;}
  .lightbox-stage{position:relative;width:100%;max-height:86vh;display:flex;align-items:center;justify-content:center;overflow:hidden;border-radius:18px;}
  .lightbox-stage img{max-width:100%;max-height:86vh;object-fit:contain;cursor:zoom-in;transition:transform .35s ease;transform-origin:center center;border-radius:14px;}
  .lightbox-stage img.zoomed{cursor:zoom-out;transform:scale(2);}
  .lightbox-close{position:absolute;top:-46px;right:0;background:var(--glass);border:1px solid var(--glass-border);border-radius:50%;width:38px;height:38px;font-size:18px;color:var(--text);z-index:2;}
  .lightbox-nav{
    position:absolute;top:50%;transform:translateY(-50%);width:44px;height:44px;border-radius:50%;
    background:rgba(11,11,14,.6);backdrop-filter:blur(8px);border:1px solid var(--glass-border);
    display:flex;align-items:center;justify-content:center;z-index:2;
  }
  .lightbox-nav svg{width:18px;height:18px;stroke:var(--text);fill:none;stroke-width:2;}
  .lightbox-nav.prev{left:-14px;}
  .lightbox-nav.next{right:-14px;}
  @media (max-width:640px){ .lightbox-nav.prev{left:4px;} .lightbox-nav.next{right:4px;} .lightbox-close{top:10px;right:10px;} }

  /* ===== Video / Shop section ===== */
  .shop-video-wrap{border-radius:16px;overflow:hidden;aspect-ratio:16/8;background:#000;box-shadow:0 30px 70px rgba(0,0,0,.5);margin:0 auto 1.5rem auto;}
  .shop-video-wrap video{width:100%;height:100%;object-fit:cover;display:block;}
  .shop-content{max-width:640px;margin:46px auto 0;text-align:center;}
  .shop-content h2{font-family:var(--serif);font-size:clamp(26px,3.6vw,40px);font-weight:600;margin:14px 0 22px;line-height:1.25;}
  html[dir="rtl"] .shop-content h2{font-family:var(--arfont);}
  .learn-more-link{display:inline-flex;align-items:center;gap:8px;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--gold-soft);border-bottom:1px solid var(--gold-soft);padding-bottom:3px;transition:color .25s ease,border-color .25s ease;}
  .learn-more-link:hover{color:var(--rose);border-color:var(--rose);}

  /* ===== Founder quote ===== */
  .founder-section{text-align:center;max-width:760px;margin:0 auto;}
  .founder-quote{font-family:var(--serif-i);font-style:italic;font-size:clamp(22px,3vw,32px);line-height:1.5;color:var(--text);margin:0 0 22px;}
  html[dir="rtl"] .founder-quote{font-family:var(--arfont);font-style:normal;}
  .founder-name{font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--gold-soft);}

  /* ===== Newsletter ===== */
  .newsletter-box{max-width:560px;margin:0 auto;text-align:center;padding:52px 40px;}
  .newsletter-box h2{font-family:var(--serif);font-size:clamp(24px,3vw,34px);margin:12px 0 10px;font-weight:600;}
  html[dir="rtl"] .newsletter-box h2{font-family:var(--arfont);}
  .newsletter-box p{color:var(--text-soft);font-size:14px;margin:0 0 26px;}
  .newsletter-form{display:flex;gap:10px;}
  .newsletter-form input{flex:1;border:1px solid var(--glass-border);background:rgba(255,255,255,.05);padding:14px 18px;border-radius:30px;color:var(--text);font-size:13px;outline:none;}
  .newsletter-form input:focus{border-color:var(--gold);}
  .newsletter-form button{
    background:linear-gradient(120deg,var(--rose-deep),var(--gold));color:#151013;border:none;padding:14px 26px;
    font-size:11px;font-weight:600;letter-spacing:.09em;text-transform:uppercase;border-radius:30px;white-space:nowrap;
  }
  @media (max-width:520px){ .newsletter-form{flex-direction:column;} }

  /* ===== Footer ===== */
  footer.site-footer{padding:54px 0 34px;text-align:center;color:var(--text-soft);font-size:12px;border-top:1px solid var(--glass-border);}
  .footer-social{display:flex;align-items:center;justify-content:center;gap:14px;margin-bottom:22px;}
  .social-btn{
    width:42px;height:42px;border-radius:50%;background:var(--glass);border:1px solid var(--glass-border);
    display:flex;align-items:center;justify-content:center;transition:background .25s ease, transform .25s ease, border-color .25s ease;
  }
  .social-btn:hover{background:var(--glass-strong);transform:translateY(-3px);border-color:var(--gold);}
  .social-btn svg{width:18px;height:18px;fill:var(--text);}
  footer.site-footer .fmark{
    display:inline-block;width:10px;height:10px;border-radius:50%;background:transparent;border:none;margin-top:14px;opacity:.25;
  }
  footer.site-footer .fmark:hover{opacity:.7;}

  /* ===== Gramophone Audio Widget ===== */
  .audio-widget{position:fixed;bottom:26px;right:26px;z-index:85;display:flex;align-items:center;gap:12px;}
  html[dir="rtl"] .audio-widget{right:auto;left:26px;}
  .audio-tooltip{
    background:rgba(11,11,14,.85);backdrop-filter:blur(10px);border:1px solid var(--glass-border);color:var(--text);
    font-size:12px;padding:9px 15px;border-radius:20px;white-space:nowrap;opacity:0;transform:translateX(8px);
    transition:opacity .3s ease, transform .3s ease;pointer-events:none;
  }
  .audio-widget:hover .audio-tooltip{opacity:1;transform:translateX(0);}
  .gramophone{
    position:relative;width:74px;height:74px;border-radius:50%;
    background:radial-gradient(circle at 35% 30%, rgba(255,255,255,.14), rgba(255,255,255,.04) 60%);
    border:1px solid var(--glass-border);backdrop-filter:blur(14px);
    display:flex;align-items:center;justify-content:center;box-shadow:0 10px 30px rgba(0,0,0,.45);
    animation:pulseGlow 2.6s ease-in-out infinite;
  }
  .gramophone.playing{animation:none;box-shadow:0 10px 40px rgba(240,168,192,.3), 0 0 0 1px rgba(216,180,126,.3);}
  @keyframes pulseGlow{
    0%,100%{box-shadow:0 10px 30px rgba(0,0,0,.45), 0 0 0 0 rgba(240,168,192,.25);}
    50%{box-shadow:0 10px 30px rgba(0,0,0,.45), 0 0 0 10px rgba(240,168,192,0);}
  }
  .vinyl{
    width:52px;height:52px;border-radius:50%;
    background:repeating-radial-gradient(circle, #1a1a1e 0px, #1a1a1e 2px, #232227 3px, #232227 4px);
    border:1px solid rgba(255,255,255,.12);position:relative;
    animation:spin 4s linear infinite;animation-play-state:paused;
  }
  .gramophone.playing .vinyl{animation-play-state:running;}
  .vinyl::after{
    content:"";position:absolute;top:50%;left:50%;width:16px;height:16px;border-radius:50%;
    background:linear-gradient(135deg,var(--gold),var(--rose-deep));transform:translate(-50%,-50%);
    box-shadow:0 0 0 1px rgba(0,0,0,.4);
  }
  @keyframes spin{from{transform:rotate(0deg);}to{transform:rotate(360deg);}}
  .needle{
    position:absolute;top:2px;right:0px;width:26px;height:3px;background:linear-gradient(90deg,var(--gold-soft),var(--gold));
    border-radius:2px;transform-origin:100% 50%;transform:rotate(-38deg);transition:transform .5s cubic-bezier(.3,1.4,.4,1);
    box-shadow:0 0 6px rgba(216,180,126,.5);
  }
  .gramophone.playing .needle{transform:rotate(2deg);}
  .needle::after{content:"";position:absolute;left:-3px;top:-2px;width:7px;height:7px;border-radius:50%;background:var(--gold-soft);}
  .eq-bars{position:absolute;bottom:-16px;left:50%;transform:translateX(-50%);display:flex;gap:3px;align-items:flex-end;height:14px;opacity:0;transition:opacity .3s ease;}
  .gramophone.playing .eq-bars{opacity:1;}
  .eq-bars i{display:block;width:3px;background:linear-gradient(180deg,var(--rose),var(--gold));border-radius:2px;animation:eq 1s ease-in-out infinite;}
  .eq-bars i:nth-child(1){animation-delay:0s;}
  .eq-bars i:nth-child(2){animation-delay:.15s;}
  .eq-bars i:nth-child(3){animation-delay:.3s;}
  .eq-bars i:nth-child(4){animation-delay:.45s;}
  @keyframes eq{0%,100%{height:4px;}50%{height:14px;}}

  /* ===== Cart Drawer ===== */
  .overlay{position:fixed;inset:0;background:rgba(5,5,7,.6);backdrop-filter:blur(2px);opacity:0;pointer-events:none;transition:opacity .35s ease;z-index:95;}
  .overlay.show{opacity:1;pointer-events:auto;}
  .cart-drawer{
    position:fixed;top:0;right:0;height:100%;width:min(430px,94vw);z-index:100;
    transform:translateX(100%);transition:transform .45s cubic-bezier(.2,.8,.2,1);display:flex;flex-direction:column;
    background:rgba(17,16,20,.85);backdrop-filter:blur(22px);-webkit-backdrop-filter:blur(22px);
    border-left:1px solid var(--glass-border);
  }
  html[dir="rtl"] .cart-drawer{right:auto;left:0;transform:translateX(-100%);border-left:none;border-right:1px solid var(--glass-border);}
  .cart-drawer.open{transform:translateX(0);}
  .cart-head{display:flex;align-items:center;justify-content:space-between;padding:26px 26px 18px;border-bottom:1px solid var(--glass-border);}
  .cart-head h3{font-family:var(--serif);font-size:24px;margin:0;color:var(--text);}
  .cart-close{background:var(--glass);border:1px solid var(--glass-border);border-radius:50%;width:34px;height:34px;font-size:18px;color:var(--text);}
  .cart-items{flex:1;overflow-y:auto;padding:10px 26px;}
  .cart-empty{text-align:center;color:var(--text-soft);padding:70px 10px;font-size:14px;}
  .cart-row{display:flex;gap:14px;padding:18px 0;border-bottom:1px solid var(--glass-border);}
  .cart-row img{width:76px;height:76px;object-fit:cover;border-radius:12px;background:rgba(255,255,255,.05);}
  .cart-row-info{flex:1;display:flex;flex-direction:column;gap:6px;}
  .cart-row-info h4{font-family:var(--serif);font-size:15px;margin:0;color:var(--text);}
  .cart-row-info .price{font-size:12px;color:var(--gold-soft);}
  .cart-row-bottom{display:flex;align-items:center;justify-content:space-between;}
  .remove-link{font-size:11px;letter-spacing:.05em;text-transform:uppercase;color:var(--text-soft);border-bottom:1px solid var(--text-soft);}
  .remove-link:hover{color:var(--rose);border-color:var(--rose);}
  .cart-foot{padding:22px 26px 30px;border-top:1px solid var(--glass-border);}
  .cart-subtotal{display:flex;justify-content:space-between;font-size:14px;margin-bottom:18px;color:var(--text-soft);}
  .cart-subtotal b{font-family:var(--serif);font-size:21px;color:var(--text);}
  .btn-primary{
    display:inline-flex;align-items:center;justify-content:center;gap:10px;width:100%;
    background:linear-gradient(120deg,var(--rose-deep),var(--gold));color:#151013;border:none;padding:15px;
    font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;border-radius:30px;
    transition:filter .25s ease, transform .25s ease;
  }
  .btn-primary:hover{filter:brightness(1.08);transform:translateY(-1px);}

  /* ===== Modal ===== */
  .modal{
    position:fixed;top:50%;left:50%;transform:translate(-50%,-46%);z-index:120;
    width:min(560px,92vw);max-height:88vh;overflow-y:auto;opacity:0;pointer-events:none;
    transition:opacity .3s ease, transform .3s ease;
    background:rgba(17,16,20,.9);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);
    border:1px solid var(--glass-border);border-radius:20px;box-shadow:0 30px 80px rgba(0,0,0,.6);
  }
  .modal.show{opacity:1;pointer-events:auto;transform:translate(-50%,-50%);}
  .modal-head{display:flex;justify-content:space-between;align-items:center;padding:24px 28px;border-bottom:1px solid var(--glass-border);}
  .modal-head h3{font-family:var(--serif);font-size:22px;margin:0;color:var(--text);}
  .modal-close{background:var(--glass);border:1px solid var(--glass-border);border-radius:50%;width:34px;height:34px;font-size:18px;color:var(--text);}
  .modal-body{padding:26px 28px 32px;}
  .field{margin-bottom:16px;}
  .field label{display:block;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--text-soft);margin-bottom:7px;}
  .field input,.field select,.field textarea{
    width:100%;border:1px solid var(--glass-border);background:rgba(255,255,255,.05);padding:12px 15px;
    font-size:14px;color:var(--text);border-radius:12px;outline:none;transition:border-color .25s ease;
  }
  .field input:focus,.field select:focus,.field textarea:focus{border-color:var(--gold);}
  .field select option{background:#161519;color:var(--text);}
  .field textarea{resize:vertical;min-height:70px;}
  .field-row{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
  .submit-whatsapp{
    width:100%;background:linear-gradient(120deg,#25D366,#1ea952);color:#fff;border:none;padding:15px;
    font-size:12px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;border-radius:30px;
    display:flex;align-items:center;justify-content:center;gap:10px;transition:filter .25s ease, transform .25s ease;
  }
  .submit-whatsapp:hover{filter:brightness(1.08);transform:translateY(-1px);}
  .admin-modal{width:min(760px,94vw);}
  .admin-tabs{display:flex;border-bottom:1px solid var(--glass-border);padding:0 28px;}
  .admin-tab{background:none;border:none;padding:14px 16px;font-size:12px;letter-spacing:.08em;text-transform:uppercase;
    color:var(--text-soft);border-bottom:2px solid transparent;}
  .admin-tab.active{color:var(--text);border-color:var(--gold);}
  .admin-panel{padding:22px 28px 32px;}
  .admin-note{color:var(--text-soft);font-size:12px;line-height:1.6;margin-bottom:18px;padding:12px 14px;border:1px solid var(--glass-border);border-radius:12px;background:rgba(255,255,255,.03);}
  .admin-table{width:100%;border-collapse:collapse;font-size:13px;}
  .admin-table th{text-align:left;font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--text-soft);
    padding:9px 6px;border-bottom:1px solid var(--glass-border);}
  .admin-table td{padding:11px 6px;border-bottom:1px solid var(--glass-border);vertical-align:middle;color:var(--text);}
  .admin-table img{width:42px;height:42px;object-fit:cover;border-radius:8px;}
  .mini-btn{background:var(--glass);border:1px solid var(--glass-border);padding:6px 11px;font-size:11px;
    margin-inline-end:4px;color:var(--text);border-radius:8px;}
  .mini-btn:hover{border-color:var(--gold);}
  .mini-btn.danger:hover{border-color:#E08A8A;color:#E08A8A;}
  .badge-stock{font-size:10px;padding:4px 9px;text-transform:uppercase;letter-spacing:.05em;border-radius:20px;}
  .badge-stock.in{background:rgba(140,220,160,.14);color:#8FDDA5;border:1px solid rgba(140,220,160,.3);}
  .badge-stock.out{background:rgba(224,138,138,.14);color:#E08A8A;border:1px solid rgba(224,138,138,.3);}
  .admin-add-form{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:20px;}
  .admin-add-form .full{grid-column:1/-1;}
  .order-card{border:1px solid var(--glass-border);background:rgba(255,255,255,.03);border-radius:14px;padding:16px;margin-bottom:12px;font-size:13px;}
  .order-card .oh{display:flex;justify-content:space-between;font-family:var(--serif);font-size:16px;margin-bottom:6px;color:var(--text);}
  .order-card .ol{color:var(--text-soft);line-height:1.6;}
  .empty-note{color:var(--text-soft);font-size:13px;padding:20px 0;}
  .auth-error{color:#E08A8A;font-size:12px;margin:-6px 0 14px;min-height:14px;}
  .btn-primary:disabled{opacity:.55;cursor:not-allowed;filter:none !important;transform:none !important;}
  .upload-status{font-size:12px;color:var(--gold-soft);margin:-6px 0 14px;display:none;align-items:center;gap:8px;}
  .upload-status.show{display:flex;}
  .upload-status .spin{width:12px;height:12px;border-radius:50%;border:2px solid rgba(216,180,126,.3);border-top-color:var(--gold);animation:spin .7s linear infinite;}
  @keyframes spin{to{transform:rotate(360deg);}}
  .img-preview-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px;}
  .img-preview-row img{width:52px;height:52px;object-fit:cover;border-radius:8px;border:1px solid var(--glass-border);}
  .admin-gate{text-align:center;padding:30px 10px;color:var(--text-soft);font-size:13px;}

  /* ===== Toast ===== */
  .toast{
    position:fixed;bottom:26px;left:50%;transform:translateX(-50%) translateY(20px);z-index:200;
    background:rgba(17,16,20,.92);backdrop-filter:blur(14px);border:1px solid var(--glass-border);color:var(--text);
    padding:13px 24px;border-radius:30px;font-size:13px;opacity:0;pointer-events:none;transition:opacity .3s ease, transform .3s ease;
  }
  .toast.show{opacity:1;transform:translateX(-50%) translateY(0);}

  /* ===== RTL fixes (cart / checkout / admin / forms) ===== */
  html[dir="rtl"] .field label,
  html[dir="rtl"] .field input,
  html[dir="rtl"] .field select,
  html[dir="rtl"] .field textarea{ text-align:right; }
  html[dir="rtl"] .admin-table th,
  html[dir="rtl"] .admin-table td{ text-align:right; }
  html[dir="rtl"] .cart-row{ text-align:right; }
  html[dir="rtl"] .cart-row-bottom{ flex-direction:row-reverse; }
  html[dir="rtl"] .cart-subtotal,
  html[dir="rtl"] .oh,
  html[dir="rtl"] .modal-head{ flex-direction:row-reverse; }
  html[dir="rtl"] .header-inner{ flex-direction:row-reverse; }
  html[dir="rtl"] .field-row{ direction:rtl; }
  html[dir="rtl"] .qty-select{ direction:ltr; }
  html[dir="rtl"] .mini-btn{ margin-inline-end:0; margin-inline-start:4px; }
  html[dir="rtl"] .cart-badge{ right:auto; left:-5px; }
  html[dir="rtl"] .lightbox-nav.prev{ left:auto; right:-14px; }
  html[dir="rtl"] .lightbox-nav.next{ right:auto; left:-14px; }
  @media (max-width:640px){
    html[dir="rtl"] .lightbox-nav.prev{ right:4px; }
    html[dir="rtl"] .lightbox-nav.next{ left:4px; }
  }
  html[dir="rtl"] .filter-tabs{ direction:rtl; }
  /* Guarantee the drawer/modal/overlay stack stays interactive and fully
     on-screen when switching to RTL — protects against any layout
     regression that could otherwise leave clicks landing on the wrong
     element or an overlay silently blocking the content behind it. */
  html[dir="rtl"] .cart-drawer,
  html[dir="rtl"] .modal{ left:auto; }
  html[dir="rtl"] .modal{ left:50%; right:auto; }
  .overlay, .cart-drawer, .modal{ will-change:transform, opacity; }
  .overlay:not(.show){ pointer-events:none !important; }
  .cart-drawer:not(.open){ pointer-events:none; }
  .modal:not(.show){ pointer-events:none; }

  /* ===== Instant search bar ===== */
  .search-bar-wrap{max-width:420px;margin:0 auto 28px;position:relative;}
  .search-bar-wrap svg{
    position:absolute;top:50%;left:18px;transform:translateY(-50%);width:16px;height:16px;
    stroke:var(--text-soft);fill:none;stroke-width:1.6;pointer-events:none;
  }
  html[dir="rtl"] .search-bar-wrap svg{left:auto;right:18px;}
  #productSearch{
    width:100%;background:var(--glass);border:1px solid var(--glass-border);border-radius:24px;
    padding:13px 18px 13px 44px;font-size:13px;color:var(--text);outline:none;transition:border-color .25s ease, background .25s ease;
  }
  html[dir="rtl"] #productSearch{padding:13px 44px 13px 18px;}
  #productSearch::placeholder{color:var(--text-soft);}
  #productSearch:focus{border-color:var(--gold);background:var(--glass-strong);}
  .search-no-results{grid-column:1/-1;text-align:center;color:var(--text-soft);font-size:14px;padding:40px 10px;}

  /* ===== Filter tabs ===== */
  .filter-tabs{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin:-24px 0 44px;}
  .filter-tab{
    background:var(--glass);border:1px solid var(--glass-border);border-radius:24px;padding:9px 20px;
    font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--text-soft);
    transition:background .25s ease, color .25s ease, border-color .25s ease;
  }
  .filter-tab:hover{color:var(--text);}
  .filter-tab.active{background:linear-gradient(120deg,var(--rose-deep),var(--gold));color:#151013;border-color:transparent;}

  /* ===== Card badges & ratings ===== */
  .card-badges{position:absolute;top:12px;left:12px;z-index:4;display:flex;flex-direction:column;gap:6px;}
  html[dir="rtl"] .card-badges{left:auto;right:12px;}
  .urgency-badge{font-size:9.5px;letter-spacing:.05em;text-transform:uppercase;padding:5px 10px;border-radius:20px;font-weight:600;backdrop-filter:blur(6px);}
  .urgency-badge.low{background:rgba(224,138,138,.85);color:#fff;}
  .urgency-badge.best{background:rgba(216,180,126,.9);color:#151013;}
  .urgency-badge.new{background:rgba(240,168,192,.9);color:#151013;}
  .card-stars{display:flex;align-items:center;gap:3px;}
  .card-stars svg{width:11px;height:11px;fill:var(--gold);}
  .card-stars svg.empty{fill:rgba(255,255,255,.18);}
  .card-share{
    position:absolute;top:12px;right:12px;z-index:4;background:rgba(11,11,14,.55);backdrop-filter:blur(6px);
    border:1px solid var(--glass-border);border-radius:50%;width:30px;height:30px;display:flex;align-items:center;justify-content:center;
    opacity:0;transition:opacity .25s ease;
  }
  html[dir="rtl"] .card-share{right:auto;left:12px;}
  .card-media:hover .card-share{opacity:1;}
  .card-share svg{width:14px;height:14px;fill:#25D366;}
  .stock-flag.out{position:absolute;bottom:12px;left:12px;z-index:4;background:rgba(11,11,14,.75);color:var(--text);
    font-size:10px;letter-spacing:.05em;text-transform:uppercase;padding:5px 10px;border-radius:20px;}
  html[dir="rtl"] .stock-flag.out{left:auto;right:12px;}
  .notify-btn{background:linear-gradient(120deg,#25D366,#1ea952) !important;color:#fff !important;}

  /* ===== Zoom lens ===== */
  .card-media.zoomable img{ cursor:zoom-in; }
  .card-media .zoom-lens{
    position:absolute;inset:0;background-repeat:no-repeat;background-size:220%;
    opacity:0;pointer-events:none;transition:opacity .2s ease;z-index:2;
  }
  .card-media:hover .zoom-lens.active{opacity:1;}

  /* ===== Free shipping progress ===== */
  .ship-progress{padding:0 26px;margin-top:4px;}
  .ship-progress p{font-size:11.5px;color:var(--text-soft);margin:0 0 8px;text-align:center;}
  .ship-progress p b{color:var(--gold-soft);}
  .ship-bar-track{height:6px;border-radius:6px;background:rgba(255,255,255,.08);overflow:hidden;}
  .ship-bar-fill{height:100%;background:linear-gradient(120deg,var(--rose-deep),var(--gold));border-radius:6px;transition:width .5s ease;}

  /* ===== Gift packaging ===== */
  .gift-option{
    display:flex;align-items:flex-start;gap:10px;padding:12px 14px;border:1px solid var(--glass-border);
    border-radius:14px;background:rgba(255,255,255,.03);margin-bottom:14px;
  }
  .gift-option input[type="checkbox"]{margin-top:3px;width:16px;height:16px;accent-color:var(--gold);flex-shrink:0;}
  .gift-option label{font-size:13px;color:var(--text);cursor:pointer;}
  .gift-option small{display:block;color:var(--text-soft);font-size:11.5px;margin-top:2px;}
  .gift-msg-field{display:none;margin-top:12px;}
  .gift-msg-field.show{display:block;}

  /* ===== Bundle upsell ===== */
  .bundle-strip{margin-top:14px;padding:16px;border:1px dashed var(--glass-border);border-radius:14px;background:rgba(255,255,255,.03);}
  .bundle-strip h4{font-family:var(--serif);font-size:14px;margin:0 0 10px;color:var(--text);}
  .bundle-row{display:flex;align-items:center;gap:12px;}
  .bundle-row img{width:48px;height:48px;object-fit:cover;border-radius:10px;}
  .bundle-row .binfo{flex:1;font-size:12px;color:var(--text-soft);}
  .bundle-row .binfo b{display:block;color:var(--text);font-size:13px;font-weight:500;}
  .bundle-add-btn{background:var(--glass);border:1px solid var(--gold);color:var(--gold-soft);border-radius:20px;padding:8px 14px;font-size:10.5px;letter-spacing:.05em;text-transform:uppercase;white-space:nowrap;}
  .bundle-add-btn:hover{background:var(--glass-strong);}

  /* ===== Care guide link ===== */
  .care-guide-link{display:inline-flex;align-items:center;gap:7px;font-size:11.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--text-soft);border-bottom:1px solid var(--glass-border);padding-bottom:2px;margin-top:16px;}
  .care-guide-link:hover{color:var(--gold-soft);border-color:var(--gold-soft);}
  .care-guide-modal .modal-body h4{font-family:var(--serif);font-size:16px;color:var(--gold-soft);margin:18px 0 8px;}
  .care-guide-modal .modal-body h4:first-child{margin-top:0;}
  .care-guide-modal .modal-body p{font-size:13px;line-height:1.7;color:var(--text-soft);margin:0;}

  /* ===== Sales proof toast ===== */
  .sales-toast{
    position:fixed;bottom:26px;left:26px;z-index:200;max-width:280px;
    background:rgba(17,16,20,.92);backdrop-filter:blur(14px);border:1px solid var(--glass-border);
    border-radius:16px;padding:12px 16px;display:flex;align-items:center;gap:10px;
    opacity:0;transform:translateY(16px);transition:opacity .4s ease, transform .4s ease;pointer-events:none;
  }
  html[dir="rtl"] .sales-toast{left:auto;right:26px;}
  .sales-toast.show{opacity:1;transform:translateY(0);}
  .sales-toast img{width:38px;height:38px;object-fit:cover;border-radius:10px;flex-shrink:0;}
  .sales-toast .stext{font-size:12px;color:var(--text);line-height:1.4;}
  .sales-toast .stext b{color:var(--gold-soft);}
  @media (max-width:520px){ .sales-toast{left:14px;right:14px;max-width:none;} html[dir="rtl"] .sales-toast{left:14px;right:14px;} }

